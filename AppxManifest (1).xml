<?xml version="1.0" encoding="utf-8"?>
<!-- The Microsoft Store package of Convert to Markdown.
     $NAME$, $PUBLISHER$, $PUBLISHERNAME$ and $VERSION$ are filled in by MakeStorePackage.ps1 from StoreIdentity.txt
     (copy them from Partner Center > your app > Product identity). -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
         xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
         xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap3 desktop4 desktop5 com rescap">
  <Identity Name="$NAME$" Publisher="$PUBLISHER$" Version="$VERSION$" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Convert to Markdown</DisplayName>
    <PublisherDisplayName>$PUBLISHERNAME$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
  <Applications>
    <Application Id="App" Executable="ConvertToMarkdown.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Convert to Markdown" Description="Convert PDFs, Office files and pictures to Markdown"
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Right-click > Open with > Convert to Markdown -->
        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="converttomarkdown" Parameters="&quot;%1&quot;">
            <uap:DisplayName>Convert to Markdown</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
            <uap:FileType>.pdf</uap:FileType>
            <uap:FileType>.docx</uap:FileType>
            <uap:FileType>.docm</uap:FileType>
            <uap:FileType>.pptx</uap:FileType>
            <uap:FileType>.pptm</uap:FileType>
            <uap:FileType>.xlsx</uap:FileType>
            <uap:FileType>.xlsm</uap:FileType>
            <uap:FileType>.png</uap:FileType>
            <uap:FileType>.jpg</uap:FileType>
            <uap:FileType>.jpeg</uap:FileType>
            <uap:FileType>.bmp</uap:FileType>
            <uap:FileType>.tif</uap:FileType>
            <uap:FileType>.tiff</uap:FileType>
            <uap:FileType>.gif</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap3:Extension>
        <!-- Right-click > Convert to Markdown (top of the Windows 11 menu) -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type=".pdf">
              <desktop5:Verb Id="ConvertToMarkdown" Clsid="6E4B2D1C-8F3A-4C7B-9A21-5D0E7F3B8C42" />
            </desktop5:ItemType>
            <desktop5:ItemType Type=".docx">
              <desktop5:Verb Id="ConvertToMarkdown" Clsid="6E4B2D1C-8F3A-4C7B-9A21-5D0E7F3B8C42" />
            </desktop5:ItemType>
            <desktop5:ItemType Type=".docm">
              <desktop5:Verb Id="ConvertToMarkdown" Clsid="6E4B2D1C-8F3A-4C7B-9A21-5D0E7F3B8C42" />
            </desktop5:ItemType>
            <desktop5:ItemType Type=".pptx">
              <desktop5:Verb Id="ConvertToMarkdown" Clsid="6E4B2D1C-8F3A-4C7B-9A21-5D0E7F3B8C42" />
            </desktop5:ItemType>
            <desktop5:ItemType Type=".pptm">
              <desktop5:Verb Id="ConvertToMarkdown" Clsid="6E4B2D1C-8F3A-4C7B-9A21-5D0E7F3B8C42" />
            </desktop5:ItemType>
            <desktop5:ItemType Type=".xlsx">
              <desktop5:Verb Id="ConvertToMarkdown" Clsid="6E4B2D1C-8F3A-4C7B-9A21-5D0E7F3B8C42" />
            </desktop5:ItemType>
            <desktop5:ItemType Type=".xlsm">
              <desktop5:Verb Id="ConvertToMarkdown" Clsid="6E4B2D1C-8F3A-4C7B-9A21-5D0E7F3B8C42" />
            </desktop5:ItemType>
            <desktop5:ItemType Type=".png">
              <desktop5:Verb Id="ConvertToMarkdown" Clsid="6E4B2D1C-8F3A-4C7B-9A21-5D0E7F3B8C42" />
            </desktop5:ItemType>
            <desktop5:ItemType Type=".jpg">
              <desktop5:Verb Id="ConvertToMarkdown" Clsid="6E4B2D1C-8F3A-4C7B-9A21-5D0E7F3B8C42" />
            </desktop5:ItemType>
            <desktop5:ItemType Type=".jpeg">
              <desktop5:Verb Id="ConvertToMarkdown" Clsid="6E4B2D1C-8F3A-4C7B-9A21-5D0E7F3B8C42" />
            </desktop5:ItemType>
            <desktop5:ItemType Type=".bmp">
              <desktop5:Verb Id="ConvertToMarkdown" Clsid="6E4B2D1C-8F3A-4C7B-9A21-5D0E7F3B8C42" />
            </desktop5:ItemType>
            <desktop5:ItemType Type=".tif">
              <desktop5:Verb Id="ConvertToMarkdown" Clsid="6E4B2D1C-8F3A-4C7B-9A21-5D0E7F3B8C42" />
            </desktop5:ItemType>
            <desktop5:ItemType Type=".tiff">
              <desktop5:Verb Id="ConvertToMarkdown" Clsid="6E4B2D1C-8F3A-4C7B-9A21-5D0E7F3B8C42" />
            </desktop5:ItemType>
            <desktop5:ItemType Type=".gif">
              <desktop5:Verb Id="ConvertToMarkdown" Clsid="6E4B2D1C-8F3A-4C7B-9A21-5D0E7F3B8C42" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="ConvertToMarkdown.exe" Arguments="-Embedding" DisplayName="Convert to Markdown menu">
              <com:Class Id="6E4B2D1C-8F3A-4C7B-9A21-5D0E7F3B8C42" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
